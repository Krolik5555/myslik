@echo off
rem Замер дрожи в графе: Мыслик открывается сразу на паутине с включённой диагностикой,
rem отчёт пишется в дрожь-отчёт.txt рядом с этим файлом. Ничего набирать не нужно.
chcp 65001 >nul
cd /d "%~dp0"
set PLANNER_SHAKE=1
echo ==============================================================
echo   ЗАМЕР ДРОЖИ
echo ==============================================================
echo   1. Откроется Мыслик на паутине, замер уже идёт.
echo   2. Возьми ноду мышью и подведи её связь к другой ноде так,
echo      чтобы та задрожала. Подержи секунд пять и отпусти.
echo   3. Повтори пару раз (можно на разных нодах), потом закрой
echo      Мыслик обычным крестиком.
echo   4. Отчёт останется в файле дрожь-отчёт.txt рядом с этим bat.
echo ==============================================================
echo.
".venv\Scripts\python.exe" "app.py"
echo.
if exist "дрожь-отчёт.txt" goto ok
echo Отчёта нет: замер не сработал, скажи Клоду.
goto end
:ok
echo Отчёт записан: %~dp0дрожь-отчёт.txt
:end
echo.
pause
